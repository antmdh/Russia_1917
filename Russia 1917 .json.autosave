:"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_FINLANDAIS\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_UKRAINIENS\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"POLONAIS\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_BALTES\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_BASMATCHI\""]}]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["soldatblanc","TYPEDECAMP","=","\"BLANCS_REGIONALISTES\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Or"},"parameters":[],"subInstructions":[{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_PAYSANS_VERT\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_MAKHNOVCHTCHINA\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"ANARCHISTES_KRONSTAD\""]}]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["soldatblanc","TYPEDECAMP","=","\"EXTREMEGAUCHE\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Or"},"parameters":[],"subInstructions":[{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_DENIKINE\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_KOLTCHACK\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_IOUDENITCH\""]},{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"KERENSKI\""]}]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["soldatblanc","TYPEDECAMP","=","\"BLANCS_NATIONALISTE\""]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["Changementdemois.QualifierletypedecampSolB","False",""]}]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"combat entre type de camp"},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CollisionNP"},"parameters":["soldatblanc","soldatblanc","","",""]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["soldatblanc","enContact","=","1"]}],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Combat ENTENTE (fr, anglais, americains,etc) contre ALLIANCE (all)"},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// On ne récupère QUE les soldats en contact","const soldats = runtimeScene","  .getObjects(\"soldatblanc\")","  .filter(s => s.getVariables().get(\"enContact\").getAsNumber() === 1);","","if (soldats.length < 2) return;","","for (let i = 0; i < soldats.length; i++) {","  for (let j = i + 1; j < soldats.length; j++) {","","    const a = soldats[i];","    const b = soldats[j];","","    const varsA = a.getVariables();","    const varsB = b.getVariables();","","    const campA = varsA.get(\"TYPEDECAMP\").getAsString();","    const campB = varsB.get(\"TYPEDECAMP\").getAsString();","","    // Combat UNIQUEMENT entre camp 1 et camp 2","    const combatAutorise =","      (campA === \"ALLIANCE\" && campB === \"ENTENTE\") ||","      (campA === \"ENTENTE\" && campB === \"ALLIANCE\");","","    if (!combatAutorise) continue;","","    // Attribution force (une seule fois)","    if (varsA.get(\"aForce\").getAsNumber() === 0) {","      varsA.get(\"forces\").setNumber(Math.floor(Math.random() * 2) + 1);","      varsA.get(\"aForce\").setNumber(1);","    }","","    if (varsB.get(\"aForce\").getAsNumber() === 0) {","      varsB.get(\"forces\").setNumber(Math.floor(Math.random() * 2) + 1);","      varsB.get(\"aForce\").setNumber(1);","    }","","    const forceA = varsA.get(\"forces\").getAsNumber();","    const forceB = varsB.get(\"forces\").getAsNumber();","","    // Égalité → séparation","    if (forceA === forceB) {","      a.separateFromObjects([b]);","      continue;","    }","","    // ⚔️ Combat avec création de \"Mort\"","    if (forceA > forceB) {","","      // Créer l'objet Mort à la position de B","      const mort = runtimeScene.createObject(\"Mort\");","      mort.setPosition(b.getX(), b.getY());","","      // Supprimer le soldat B","      b.deleteFromScene(runtimeScene);","","    } else {","","      // Créer l'objet Mort à la position de A","      const mort = runtimeScene.createObject(\"Mort\");","      mort.setPosition(a.getX(), a.getY());","","      // Supprimer le soldat A","      a.deleteFromScene(runtimeScene);","    }","  }","}",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Combat ENTENTE (fr, anglais, americains,etc) contre EXTREME GAUCHE"},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// On ne récupère QUE les soldats en contact","const soldats = runtimeScene","  .getObjects(\"soldatblanc\")","  .filter(s => s.getVariables().get(\"enContact\").getAsNumber() === 1);","","if (soldats.length < 2) return;","","for (let i = 0; i < soldats.length; i++) {","  for (let j = i + 1; j < soldats.length; j++) {","","    const a = soldats[i];","    const b = soldats[j];","","    const varsA = a.getVariables();","    const varsB = b.getVariables();","","    const campA = varsA.get(\"TYPEDECAMP\").getAsString();","    const campB = varsB.get(\"TYPEDECAMP\").getAsString();","","    // Combat UNIQUEMENT entre camp 1 et camp 2","    const combatAutorise =","      (campA === \"EXTREMEGAUCHE\" && campB === \"ENTENTE\") ||","      (campA === \"ENTENTE\" && campB === \"EXTREMEGAUCHE\");","","    if (!combatAutorise) continue;","","    // Attribution force (une seule fois)","    if (varsA.get(\"aForce\").getAsNumber() === 0) {","      varsA.get(\"forces\").setNumber(Math.floor(Math.random() * 2) + 1);","      varsA.get(\"aForce\").setNumber(1);","    }","","    if (varsB.get(\"aForce\").getAsNumber() === 0) {","      varsB.get(\"forces\").setNumber(Math.floor(Math.random() * 2) + 1);","      varsB.get(\"aForce\").setNumber(1);","    }","","    const forceA = varsA.get(\"forces\").getAsNumber();","    const forceB = varsB.get(\"forces\").getAsNumber();","","    // Égalité → séparation","    if (forceA === forceB) {","      a.separateFromObjects([b]);","      continue;","    }","","    // ⚔️ Combat avec création de \"Mort\"","    if (forceA > forceB) {","","      // Créer l'objet Mort à la position de B","      const mort = runtimeScene.createObject(\"Mort\");","      mort.setPosition(b.getX(), b.getY());","","      // Supprimer le soldat B","      b.deleteFromScene(runtimeScene);","","    } else {","","      // Créer l'objet Mort à la position de A","      const mort = runtimeScene.createObject(\"Mort\");","      mort.setPosition(a.getX(), a.getY());","","      // Supprimer le soldat A","      a.deleteFromScene(runtimeScene);","    }","  }","}",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Combat ALLIANCE (all) contre EXTREME GAUCHE"},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// On ne récupère QUE les soldats en contact","const soldats = runtimeScene","  .getObjects(\"soldatblanc\")","  .filter(s => s.getVariables().get(\"enContact\").getAsNumber() === 1);","","if (soldats.length < 2) return;","","for (let i = 0; i < soldats.length; i++) {","  fo