ype":{"value":"ResetTimer"},"parameters":["","\"fonction1_BlancsduNord\""]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT2_fonctiondobservation","=","11.6"]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT2_fonctiondobservation","=","0"]}]},{"disabled":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT2_fonctiondobservation","=","11.1"]},{"type":{"value":"CompareTimer"},"parameters":["","\"fonction1_BlancsduNord\"",">=","duree_fonction_1_IA"]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT2_fonctiondobservation","=","0"]}]},{"disabled":true,"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":194,"g":227,"r":80,"textB":0,"textG":0,"textR":0},"comment":"3. IA D'ACTION"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"2.FONCTION D'ANALYSE et d'ACTION\nOn a plusieurs profils\nJOUEUR = Ne donne aucun ordre aux troupes du joueur\nINACTIF = Ne va pas conquérir de nouvelles villes et attaque uniquement une troupes très très proche\nACTIF_LIMITE = Attaque les villes sur la liste\n\n---------------------------------------------------------------\n                                      Troupes ennemis a proximite \n                                                 FAUX     |          VRAI\n------------------------------------- |-------------------------\nTroupes allies.  FAUX |    Attaque ville | 50% ennemis proche      |\nA proximité                  | la plus proche | 50% vile la plus proche  |\nA proximité                  | de la liste         |                                          |\nA proximité                  | sinon rien         |                                          |\n                          ---------------------- |-----------------------   |\n                          VRAI   | idem.               |  80% ennemis                 |\n                                      |                         |   20% ville                        |\n                                     |                          |                                          |\n----------------------------------------------------------------\n\n\n\nACTIF = Attaque selon les regles suivantes\n- si troupes ennemis a proximite FAUX et troupes allies a proximite FAUX\n=> attaque la premiere ville de la liste\n- si troupes ennemis a proximite FAUX et troupes allies a proximite VRAI\n=> attaque moscou ou petrograd ou la ville la plus proche\n- si troupes ennemis a proximite VRAI et troupes allies a proximite FAUX\n=> attaque troupes ennemis dans 80% des cas sinon ville la plus proche\n- si troupes ennemis a proximite VRAI et troupes allies a proximite VRAI\n=> attaque troupes ennemis dans 50% des cas sinon ville la plus proche\n\n\n\nACTIF\n---------------------------------------------------------------\n                                      Troupes ennemis a proximite \n                                                 FAUX     |          VRAI\n------------------------------------- |-------------------------\nTroupes allies.  FAUX |    Attaque ville | 50% ennemis                   |\nA proximité                  | la plus proche | 50% vile la plus proche  |\n                          ---------------------- |-----------------------   |\n                          VRAI   | Attaque            |  80% ennemis                 |\n                                      | Moscou           |   20% ville                        |\n                                     | Ou petrogra     |  la plus proche                |\n----------------------------------------------------------------\nsi aucune ville ou soldat detecté = augmenter taille du cercle\n\nEtablis une liste de ville par priorite\n\net tant qu'un soldat n'a pas de cible, il lui donne une destination\nsi aucun soldat sans cible, il attend 10 sec\n\n\n"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Je vais donner l'ordre d'attaque à mes soldat,  soit une ville (20% de chance) soit un soldat à proximité (80% de chance), si pas de soldat j'attaque une ville.\nChoix de la chance d'attaquer l'un ou l'autre"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Etape 0 je choisis le sous camp qui va bouger ses soldats"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"Wait"},"parameters":["10"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT3_fonctiondaction","=","0"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT3_fonctiondaction","=","0"]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["campdedepart_Blanc