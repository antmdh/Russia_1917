]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Petrograd est en danger mais pas Moscou"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CompareTimer"},"parameters":["","\"perteMoscou\"","<=","1"]},{"type":{"value":"CompareTimer"},"parameters":["","\"pertePetrograd\"","<=","120"]},{"type":{"value":"CompareTimer"},"parameters":["","\"pertePetrograd\"",">","1"]}],"actions":[{"type":{"value":"Montre"},"parameters":["Affiche_propagande_alerte",""]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Affiche_propagande_alerte","Animation","=","\"ilfautreprendrepetrograd\""]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscou_TXT1"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscou_TXT2"]},{"type":{"value":"Montre"},"parameters":["ilfautreprendrePetrograd_TXT1",""]},{"type":{"value":"Montre"},"parameters":["ilfautreprendrePetrograd_TXT2",""]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscouetPetrograd_TXT1"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscouetPetrograd_TXT2"]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Petrograd est aussi Moscou"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CompareTimer"},"parameters":["","\"perteMoscou\"","<=","120"]},{"type":{"value":"CompareTimer"},"parameters":["","\"perteMoscou\"",">","1"]},{"type":{"value":"CompareTimer"},"parameters":["","\"pertePetrograd\"","<=","120"]},{"type":{"value":"CompareTimer"},"parameters":["","\"pertePetrograd\"",">","1"]}],"actions":[{"type":{"value":"Montre"},"parameters":["Affiche_propagande_alerte",""]},{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["Affiche_propagande_alerte","Animation","=","\"IlfautreprendreMoscouetpetrograd\""]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscou_TXT1"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscou_TXT2"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendrePetrograd_TXT1"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendrePetrograd_TXT2"]},{"type":{"value":"Montre"},"parameters":["ilfautreprendreMoscouetPetrograd_TXT1",""]},{"type":{"value":"Montre"},"parameters":["ilfautreprendreMoscouetPetrograd_TXT2",""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"PARTIE PERDUE"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"Cache"},"parameters":["Relancerlejeu"]},{"type":{"value":"ActivateBehavior"},"parameters":["Relancerlejeu","ButtonFSM","no"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Or"},"parameters":[],"subInstructions":[{"type":{"value":"CompareTimer"},"parameters":["","\"pertePetrograd\"",">=","120"]},{"type":{"value":"CompareTimer"},"parameters":["","\"perteMoscou\"",">=","120"]}]}],"actions":[{"type":{"value":"Montre"},"parameters":["MessageAcceuil_Arriere_fond",""]},{"type":{"value":"Montre"},"parameters":["MessageAcceuil_Barrerouge",""]},{"type":{"value":"Montre"},"parameters":["MessageAcceuil_Titre1",""]},{"type":{"value":"BBText::SetBBText"},"parameters":["MessageAcceuil_Titre1","=","\"[size=60][b]ECHEC[/b] [/size]\""]},{"type":{"value":"Montre"},"parameters":["MessageAcceuil_Titre2",""]},{"type":{"value":"BBText::SetBBText"},"parameters":["MessageAcceuil_Titre2","=","\"[size=45][b]Vous n'avez pas su conserver Petrograd et Moscou[/b] [/size]\""]},{"type":{"value":"Montre"},"parameters":["MessageAcceuil_Texte",""]},{"type":{"value":"SetNumberVariable"},"parameters":["etat_vitesse","=","1"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["MessageAcceuil_Texte","Text","=","\"Vous avez échoué à conserver les deux villes les plus importante de l'ancienne empire tsariste. Les masses populaires n'ont plus confiance dans votre parti pour conserver le pouvoir. \nHeureusement camarade, toi, tu peux à nouveau essayer de réussir la révolution\""]},{"type":{"value":"Montre"},"parameters":["Relancerlejeu",""]},{"type":{"value":"ActivateBehavior"},"parameters":["Relancerlejeu","ButtonFSM","yes"]},{"type":{"value":"Cache"},"parameters":["Affiche_propagande_alerte"]},{"type":{"value":"Cache"},"parameters":["miniville"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendrePetrograd_TXT1"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendrePetrograd_TXT2"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscou_TXT1"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscou_TXT2"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscouetPetrograd_TXT1"]},{"type":{"value":"Cache"},"parameters":["ilfautreprendreMoscouetPetrograd_TXT2"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"ButtonStates::ButtonFSM::IsClicked"},"parameters":["Relancerlejeu","ButtonFSM",""]}],"actions":[{"type":{"value":"Scene"},"parameters":["","\"ZONE_MENU\"",""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Propagande horizontal, l'image change chaque mois"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetIndex"},"parameters":["Affiche_propagande_dynamique","Animation","=","Affiche_propagande_horizontal"]}]}]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"15. SCENARIO","source":"","type":"BuiltinCommonInstructions::Group","events":[],"parameters":[]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Résumé\n\n191711:\nApparitions troupes allemandes et possèdes Varsovie, Brest Litovsk\nApparitions troupes Bolcheviks 3 à Petrograd\nApparitions troupes du Tsar à Moscou 1 dans chaque ville\nDécision de valider le décrét sur la terre \n=> Si oui provoque l'apparition de 2 troupes rouges dans les villes occidentales (Kharkov, samara, perm, omsk, Kazan, Ikeatrinaburg, Ikursk) + 5 troupes Bolcheviks au nord de Helsinksi + 5troupes à Kiev\nDécision de valider le décrét sur la paix => Allemand cesse d'attaquer jusqu'a Brest Litovsk\nDécision de valider le décret sur les driots des peuples => apparition des troupes rouges à Tashkent\n\n191712\nDécision de créer la Tcheka : les services secret si au moins une armée rouge existe\nSi oui : Les villes bolcheviks ne se révoltent pas\nDécision : Donner indépendance àl a Finlande\nSi oui : Finlande devient indépendante, apparition de frontière, apparitions troupes nationales à Helsinksi mais se battent que sur leur territoire, apparition de troupes allemandes en Finlande, troupes bolcheviks en Finlande deviennent indépendante\nSi non : troupes nationalistes apparaissent à Helsinki mais essaye aussi de prendre Mourmasnk et archangalesk.\n\n191801\n=> Création armée rouge si au moins une armée rouge existe\nSi oui on peut créer des troupes rouges\n=> Indépendance ukraine si NA\nSi oui : Ukraine devient indépendante, apparition de frontière, apparitions troupes nationales à Kiev mais se battent que sur leur territoire, troupes bolcheviks en Ukraine deviennent indépendante\nSi non : troupes nationalistes apparaissent à Kiev et  essaye aussi de prendre Sebastobol et Karkov.\n=> Dissolution de l'assemblée constituante\nSi oui = La république sera soviétique mais dénonciation des USA, FRANCE, JAPON, Grande Bretagne\nSi non = La république de Russie socialiste et à chaque tour suivant l'assemblée constituante demande suppression du decret sur la terre et sur le droit des peuples.\n\n191802\n1er accord de Brest Litovsk si les allemands existe toujours\n=> Si oui : ALlemande ne bouge pas\n=> Si non Allemand attaque en masse Riga, Minsk, Kharkov, sebastopol, Kiev\n\n191803\n2e accord de Brest Litovsk si non au premier\n=> Si oui : Allemand ne bouge pas\n=> SI non : Allemanda attaque Moscou et Petrograd\nBielorussie demande son indépendance\n=> Si oui Bielorussie devient indépendante, apparition de frontière, apparitions troupes national àMinks mais se batte que sur leur territoires, les troupes bolcheviks deviennent indépendantes\nSi non troupes nationalistes apparaissent à Minsk\n\n191804\nDebarquement japonais à Khabarovsk\nDebut révolte legion tchèqueà Omsk et Novosibirsk \n\n191805\nDebarquement anglais et américains à Archangel et Mourmansk\n\n191806 \n\n191807 : execution de la famille du tsar\n\n191808 : tentative d'assasinat sur lénine (réussi si la tcheka n'a pas été crée sinon echec de la partie, tu n'as plus le controle des décisions)\n\n\n191809\nDécider de créer la terreur rouge (si oui creation les armées blanches vont prendre moscou et menee une lutte à mort) si non (refus de créer des troupes bolcheviks pendant 6 mois)\n\n191810\n\n191811 \nFin de la guerre avec l'allemagne, les troupes etrounent en allemagne et disparaissent\nPolonais apparaissent à Varsovie et tente de conquerir Brest litovsk, Riga, Minsk, Kiev\n=Decision Reconnaitre l'independance polonaise version maximum\nSi oui (on donne  Brest litovsk, Riga, Minsk, Kiev) alors troupes francaise et anglaise quittent le pays mais impossibilité de rejoindre Berlin et faire la révolution mondiale\nSi non (on continue la guerre jusqu'a ce que Varsovie tombe ou bien nouveau traité de paix en 1921 sur frontière actuelle)\n\n\n191812\nDébut de l'intervention française en Ukraine (sebastopol)et en Crimée ; Débarquement des troupes britanniques dans le Caucase (rostov, tbilisi)\n\nLes camps\n=> Troupes fidèle au  tsar : existe au début, ne peuvent pas créer de troupes\n=> blancs ne peuvent pas conquérier des villes qui sont déja blanches\n=> Legion tcheque qui cherche a conquérier tout le transibérien de Iekatrinaburg à Vladivostok\n=> Polonais chercher à conquérir Brest Litovsk Riga Minsk Kiev\n\n\n\n\n\n\n"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Date et apparition de chaque camp"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Ville possédé par chaque camp au départ"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Evenement qui determine action de chaque camp"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"CREATION TABLE EVENEMENT"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.DATE_NBR"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.CAMP_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.STATUT_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.VILLES_ACQUISES_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.UNITE_A_CONSTRUIRE_NBR"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.VILLE_A_CIBLER_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.Ligne_ecritedanslejeu"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.Centre_creation_soldat_X_NBR"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.Centre_creation_soldat_Y_NBR"]},{"type":{"value":"SetNumberVariable"},"parameters":["TABLE_COMPORTEMENT_IA.Valeur_Processus_IA_lancement","=","1"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"para