soldats.length; i++) {","  for (let j = i + 1; j < soldats.length; j++) {","","    const a = soldats[i];","    const b = soldats[j];","","    const varsA = a.getVariables();","    const varsB = b.getVariables();","","    const campA = varsA.get(\"Souscampsoldatblanc\").getAsString();","    const campB = varsB.get(\"Souscampsoldatblanc\").getAsString();","","    // Combat UNIQUEMENT entre camp 1 et camp 2","    const combatAutorise =","      (campA === \"1\" && campB === \"2\") ||","      (campA === \"2\" && campB === \"1\");","","    if (!combatAutorise) continue;","","    // Attribution force (une seule fois)","    if (varsA.get(\"aForce\").getAsNumber() === 0) {","      varsA.get(\"forces\").setNumber(Math.floor(Math.random() * 2) + 1);","      varsA.get(\"aForce\").setNumber(1);","    }","","    if (varsB.get(\"aForce\").getAsNumber() === 0) {","      varsB.get(\"forces\").setNumber(Math.floor(Math.random() * 2) + 1);","      varsB.get(\"aForce\").setNumber(1);","    }","","    const forceA = varsA.get(\"forces\").getAsNumber();","    const forceB = varsB.get(\"forces\").getAsNumber();","","    // Égalité → séparation","    if (forceA === forceB) {","      a.separateFromObjects([b]);","      continue;","    }","","    // ⚔️ Combat avec création de \"Mort\"","    if (forceA > forceB) {","","      // Créer l'objet Mort à la position de B","      const mort = runtimeScene.createObject(\"Mort\");","      mort.setPosition(b.getX(), b.getY());","","      // Supprimer le soldat B","      b.deleteFromScene(runtimeScene);","","    } else {","","      // Créer l'objet Mort à la position de A","      const mort = runtimeScene.createObject(\"Mort\");","      mort.setPosition(a.getX(), a.getY());","","      // Supprimer le soldat A","      a.deleteFromScene(runtimeScene);","    }","  }","}",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"inverted":true,"value":"CollisionNP"},"parameters":["soldatblanc","soldatblanc","","",""]},{"type":{"value":"NumberObjectVariable"},"parameters":["soldatblanc","enContact","=","1"]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["soldatblanc","enContact","=","0"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["soldatblanc","forces","=","0"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["soldatblanc","aForce","=","0"]}]},{"type":"BuiltinCommonInstructions::ForEach","object":"soldatblanc","conditions":[{"type":{"value":"ButtonStates::ButtonFSM::IsHovered"},"parameters":["soldatblanc","ButtonFSM",""]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["NewText","Text","=","\"souscamp\n\"+soldatblanc.Souscampsoldatblanc+\n\"\nforce\n\"+soldatblanc.forces+\"\nsous blanc en contact\n\"+soldatblanc.blancencontact+\"\naforce\n\"+soldatblanc.aForce"]}]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","top":"Z+"},"booleanParame