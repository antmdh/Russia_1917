FICHE_INFO_INDICE.BLANCS_PAYSANS_VERT]"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_PAYSANS_VERT",">","9"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_PAYSANS_VERT","=","1"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_PAYSANS_VERT","<=","9"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_PAYSANS_VERT","+","1"]}]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["soldatblanc","Souscampsoldatblanc","=","\"BLANCS_BALTES\""]}],"actions":[{"type":{"value":"AnimatableCapability::AnimatableBehavior::SetName"},"parameters":["fiche_illustration","Animation","=","\"BLANCS_BALTES\""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["Texte_FICHE_TITRE_22","Text","=","FICHIE_INFO.BLANCS_BALTES[0]"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["Texte_FICHE_TEXTE_103","Text","=","FICHIE_INFO.BLANCS_BALTES[FICHE_INFO_INDICE.BLANCS_BALTES]"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_BALTES",">","9"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_BALTES","=","1"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_BALTES","<=","9"]}],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["FICHE_INFO_INDICE.BLANCS_BALTES","+","1"]}]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]}]}]}]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"15. SCENARIO","source":"","type":"BuiltinCommonInstructions::Group","events":[],"parameters":[]},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Résumé\n\n191711:\nOK\nApparitions troupes allemandes et possèdes Varsovie, Brest Litovsk OK\nApparitions troupes Bolcheviks 3 à Petrograd OK\nApparitions troupes du Tsar à Moscou 1 OK\nPAS OK\nDécision de valider le décrét sur la terre \n=> Si oui provoque l'apparition de 2 troupes rouges dans les villes occidentales (Kharkov, samara, perm, omsk, Kazan, Ikeatrinaburg, Ikursk) + 5 troupes Bolcheviks au nord de Helsinksi + 5troupes à Kiev\nDécision de valider le décrét sur la paix => Allemand cesse d'attaquer jusqu'a Brest Litovsk\nDécision de valider le décret sur les driots des peuples => apparition des troupes rouges à Tashkent\n\n191712\nOK\napparition troupes en finlande 5 OK\napparition troupes bolchevik en finlande 5 OK\nPAS OK\nDécision de créer la Tcheka : les services secret si au moins une armée rouge existe\nSi oui : Les villes bolcheviks ne se révoltent pas\nDécision : Donner indépendance àl a Finlande\nSi oui : Finlande devient indépendante, apparition de frontière, apparitions troupes nationales à Helsinksi mais se battent que sur leur territoire, apparition de troupes allemandes en Finlande, troupes bolcheviks en Finlande deviennent indépendante\nSi non : troupes nationalistes apparaissent à Helsinki mais essaye aussi de prendre Mourmasnk et archangalesk.\n\n191801\nOK\nApparition troupes ukraine 10 OK\nPAS OK\n=> Création armée rouge si au moins une armée rouge existe\nSi oui on peut créer des troupes rouges\n=> Indépendance ukraine si NA\nSi oui : Ukraine devient indépendante, apparition de frontière, apparitions troupes nationales à Kiev mais se battent que sur leur territoire, troupes bolcheviks en Ukraine deviennent indépendante\nSi non : troupes nationalistes apparaissent à Kiev et  essaye aussi de prendre Sebastobol et Karkov.\n=> Dissolution de l'assemblée constituante\nSi oui = La république sera soviétique mais dénonciation des USA, FRANCE, JAPON, Grande Bretagne\nSi non = La république de Russie socialiste et à chaque tour suivant l'assemblée constituante demande suppression du decret sur la terre et sur le droit des peuples.\n\n191802\n1er accord de Brest Litovsk si les allemands existe toujours\n=> Si oui : ALlemande ne bouge pas\n=> Si non Allemand attaque en masse Riga, Minsk, Kharkov, sebastopol, Kiev OK\n\n191802\nOK\n=etat baltes procalme; leur idenepdance 5 troupes à Riga et 5 troupes a tallin actif limite OK\n191803\n2e accord de Brest Litovsk si non au premier\n=> Si oui : Allemand ne bouge pas\n=> SI non : Allemanda attaque Moscou et Petrograd\nBielorussie demande son indépendance\n=> Si oui Bielorussie devient indépendante, apparition de frontière, apparitions troupes national àMinks mais se batte que sur leur territoires, les troupes bolcheviks deviennent indépendantes\nSi non troupes nationalistes apparaissent à Minsk OK\n\n191804\nOK\nDebarquement japonais à Khabarovsk OK\nDebut révolte legion tchèqueà Omsk et Novosibirsk  OK\n\n191805\nOK\nDebarquement anglais et américains à Archangel et Mourmansk OK\n\n191806 \nApparition des troupes blanche de denikine a Rostov 9 troupes OK\n\n191807 : execution de la famille du tsar\n\n191808 : tentative d'assasinat sur lénine (réussi si la tcheka n'a pas été crée sinon echec de la partie, tu n'as plus le controle des décisions)\n\n\n191809\nDécider de créer la terreur rouge (si oui creation les armées blanches vont prendre moscou et menee une lutte à mort) si non (refus de créer des troupes bolcheviks pendant 6 mois)\n\n191810\n\n191811 \nFin de la guerre avec l'allemagne, les troupes etrounent en allemagne et disparaissent\nPolonais apparaissent à Varsovie et tente de conquerir Brest litovsk, Riga, Minsk, Kiev OK\n=Decision Reconnaitre l'independance polonaise version maximum\nSi oui (on donne  Brest litovsk, Riga, Minsk, Kiev) alors troupes francaise et anglaise quittent le pays mais impossibilité de rejoindre Berlin et faire la révolution mondiale\nSi non (on continue la guerre jusqu'a ce que Varsovie tombe ou bien nouveau traité de paix en 1921 sur frontière actuelle)\n\nApparition de 10 soldats Blancs_koltchak à Omsk OK\n\n191812\nDébut de l'intervention française en Ukraine (sebastopol)et en Crimée ; Débarquement des troupes britanniques dans le Caucase (rostov, tbilisi) OK\napparitions des troupes bolcheviks a Riga (bolcheviks lettons) 5 OK\nApparitions d'1 troupes Basmatchia autour de Tashkent OK\n\nLes camps\n=> Troupes fidèle au  tsar : existe au début, ne peuvent pas créer de troupes\n=> blancs ne peuvent pas conquérier des villes qui sont déja blanches\n=> Legion tcheque qui cherche a conquérier tout le transibérien de Iekatrinaburg à Vladivostok\n=> Polonais chercher à conquérir Brest Litovsk Riga Minsk Kiev\n\n\n19101\nApparitions d'1 troupes Basmatchia autour de Tashkent OK\n1902\n=> Premier Congrès de l'Internationale communiste (Komintern) à Moscou.\nApparitions d'1 troupes Basmatchia autour de TashkentOK\n1903\n=> VIIIe Congrès du Parti communiste russe (bolchevique), adoption du premier programme du parti.\nApparitions d'1 troupes Basmatchia autour de TashkentOK\n\n191904\n=> Retrait des troupes françaises d'Odessa (Ukraine).\nApparitions d'1 troupes Basmatchia autour de TashkentOK\n191905\n=> Offensive des armées blanches de Dénikine dans le sud de la Russie.\nApparitions d'1 troupes Basmatchia autour de TashkentOK\n191906\nApparitions d'1 troupes Basmatchia autour de TashkentOK\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n191907\nApparitions d'1 troupes Basmatchia autour de TashkentOK\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n191908\nApparitions d'1 troupes Basmatchia autour de TashkentOK\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n191909\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\nApparitions d'1 troupes Basmatchia autour de TashkentOK\n191910\nIoudenitch cree 5 troupes à RIGA ok\nApparitions d'1 troupes Basmatchia autour de TashkentOK\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n191911\ntroupes Ioudenitch fuyent \nApparitions d'1 troupes Basmatchia autour de TashkentOK\nBrittanique se retire du nord de la russie\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n\n191912 = apparitions de trois unités verte INACTIF au NORD de TSARISTYNE OK\nApparitions d'1 troupes Basmatchia autour de TashkentOK\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n\n192001\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n192002\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n192003\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n\ndepart eds troupes americaines\n\n\n192004\n 10 troupes polonaisses apparaissent a varsovie\n192005\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n192006\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n192007\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n192008\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n192009\ndejuin 1919 a octobre 1920 apparitions de 1 \"BLANCS_MAKHNOVCHTCHINA\" à l'est de l'urkain par mois\n\n192101 revolte kronstad 10 soldat apparaissent a petrograd OK\n\n1921 03 Xe congres du parti\n1921 05 famines\n\n192107 debut NEP\n\n1922 03 11e congres du parti\n\n192207 depart des japonais\n\n192212 creation URSSvert"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Date et apparition de chaque camp"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Ville possédé par chaque camp au départ"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Evenement qui determine action de chaque camp"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"CREATION TABLE EVENEMENT"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.DATE_NBR"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.CAMP_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.STATUT_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.VILLES_ACQUISES_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.UNITE_A_CONSTRUIRE_NBR"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.VILLE_A_CIBLER_TXT"]},{"type":{"value":"ClearVariableChildren"},"parameters":["TABLE_COMPORTEMENT_IA.Ligne_ecritedanslejeu"]},{"type":{"value":"Cl