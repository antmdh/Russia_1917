tions":[{"type":{"value":"TiledSpriteObject::SetColor"},"parameters":["Pixeloeuvredarttuiles","\"53;51;50\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Pixeloeuvredarttuiles","Nombredemort","=","8"]}],"actions":[{"type":{"value":"TiledSpriteObject::SetColor"},"parameters":["Pixeloeuvredarttuiles","\"26;25;33\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Pixeloeuvredarttuiles","Nombredemort",">=","9"]}],"actions":[{"type":{"value":"TiledSpriteObject::SetColor"},"parameters":["Pixeloeuvredarttuiles","\"0;0;0\""]}]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"cheat code"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]}],"parameters":[]},{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"8. IA strategique unique des blancs et apparitions des troupes","source":"","type":"BuiltinCommonInstructions::Group","events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"D'abord il ya plusieurs camps blanc (allemand, kotchak, pays etrangers), on identifie ville qui sont en leur possession et troupes qui sot en leur possession\n\nON a les blancs du nord\nLes blancs de l'extreme orient\nLes blancs du caucase\nLes blancs du sud\nLes nationalistes d ukraine (ne veulent que certaines villes)\nles nationalistes du belarus(ne veulent que certaines villes)\nles nationalistes de pologne(ne veulent que certaines villes)\nles nationalistes de finlande(ne veulent que certaines villes)\nles anarchistes d ukraine (ne veulent pas de villes)\nles verts (ne veulent pas de villes)\nles allemands (ne veulent que ceraines villes et fuient en nov 18)\nles americains (ne veulent pas de villes)\nles anglais (ne veulent pas de villes)\nles francais (ne veulent pas de villes)\nles japonais (ne veulent pas de villes)\n\n\nUPDATE 4 mars 2025\nCode OK mais il faut rajouter la fitesse selon le terrain\nreduire le tremblement\nrajouter la creation d'unite\n\nupdate 18 03 2025\n\nle code blanc du sud est le plus avance, il doit remplacer les autre.\nles blancs du sud vont chaqu fois chercher des ennemis loin au lieu de prendre des villes proches, je ne comprend pas\n\n\nUpdatz 15 avril 2025\nJe trouve que e code est trop long et ne rend pas les soldats independants, je recommence blanc du nor avec une logiu eplus simple\nFontion de detection\nfonction de decision\nfonction de distribution à chaque soldat\n"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"cheat code IA"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"Cache"},"parameters":["log"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"SetCameraCenterX"},"parameters":["","=","1100","",""]},{"type":{"value":"SetCameraCenterY"},"parameters":["","=","1100","",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CollisionNP"},"parameters":["soldatblanc","soldatblanc","","",""]}],"actions":[{"type":{"value":"SeparateFromObjects"},"parameters":["soldatblanc","soldatblanc",""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":194,"g":227,"r":80,"textB":0,"textG":0,"textR":0},"comment":"1. IA INSTALLATION QUI etudie les circonstances du mois pour chaque entité et enregistre la plus recente coordonné\"es. Tourne à chaque FRAME"},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartS