,"","        if (distance < minDistance) {","            minDistance = distance;","            closestInstance = instance;","        }","    }","}","","// Si on a trouvé une instance la plus proche","if (closestInstance) {","    // Récupérer ses coordonnées","    let x = closestInstance.getX();","    let y = closestInstance.getY();","","    // Si jamais une des coordonnées est null, on les remplace par 0","    if (x === null || isNaN(x)) x = 0;","    if (y === null || isNaN(y)) y = 0;","","    // Copier la position du plus proche dans les variables du camp","    camp.getVariables().get(\"Creationsoldat_boutonaactiverX\").setNumber(x);","    camp.getVariables().get(\"Creationsoldat_boutonaactiverY\").setNumber(y);","} else {","    // Si aucun soldat trouvé, on met aussi 0,0 pour éviter les valeurs vides","    camp.getVariables().get(\"Creationsoldat_boutonaactiverX\").setNumber(0);","    camp.getVariables().get(\"Creationsoldat_boutonaactiverY\").setNumber(0);","}","",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","etapecreationsoldat","=","7"]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","etapecreationsoldat","=","5"]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"ResetObjectTimer"},"parameters":["campdedepart_Blancs_IA_unique","\"creationdesoldat\""]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":0,"g":200,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Étape 5 : Calcul de l'ordre des boutons à activer"},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","etapecreationsoldat","=","5"]}],"actions":[{"