xtR":0},"comment":"4. Changement de l'entete du document scenario en parti communiste a partir de Mars 1918"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["CALENDRIER_YEARMONTH_TXT","=","\"191710\""]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["ENTETE_DOCUMENT_SCENARIO_TXT","Text","=","\"Parti ouvrier social-démocrate\nde Russie (bolchevik)\nP O S D R (b)\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["CALENDRIER_YEARMONTH_TXT","=","\"191711\""]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["ENTETE_DOCUMENT_SCENARIO_TXT","Text","=","\"Parti ouvrier social-démocrate\nde Russie (bolchevik)\nP O S D R (b)\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["CALENDRIER_YEARMONTH_TXT","=","\"191712\""]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["ENTETE_DOCUMENT_SCENARIO_TXT","Text","=","\"Parti ouvrier social-démocrate\nde Russie (bolchevik)\nP O S D R (b)\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringVariable"},"parameters":["CALENDRIER_YEARMONTH_TXT","=","\"191801\""]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["ENTETE_DOCUMENT_SCENARIO_TXT","Text","=","\"Parti ouvrier social-démocrate\nde Russie (bolchevik)\nP O S D R (b)\""]}]},{"type":"Buil