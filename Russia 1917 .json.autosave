,"eventsFunctionContext.returnValue = parseInt(convString, convBase);",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"expression"},"parameters":[{"description":"String representing a number","name":"String","type":"string"},{"description":"The base the number in the string is in","name":"Base","type":"expression"}],"objectGroups":[]},{"description":"Converts a number to a trsing representing it in another base.","fullName":"Convert to different base","functionType":"StringExpression","name":"ToBase","sentence":"","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const convNum = eventsFunctionContext.getArgument(\"Num\");","const convBase = eventsFunctionContext.getArgument(\"Base\");","eventsFunctionContext.returnValue = convNum.toString(convBase);",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"expressionType":{"type":"string"},"parameters":[{"description":"Number to convert","name":"Num","type":"expression"},{"description":"The base to convert the number to","name":"Base","type":"expression"}],"objectGroups":[]}],"eventsBasedBehaviors":[],"eventsBasedObjects":[]},{"author":"@arthuro555 and @Add00","category":"User interface","dimension":"","extensionNamespace":"","fullName":"Input Validation","gdevelopVersion":">=5.5.222","helpPath":"","iconUrl":"data:image/svg+xml;base64,","name":"InputValidation","previewIconUrl":"https://resources.gdevelop-app.com/assets/Icons/Line Hero Pack/Master/SVG/Education and Learning/Education and Learning_education_book_library_search.svg","shortDescription":"Conditions and expressions to check, sanitize and manipulate strings.","version":"1.0.1","description":"Provides conditions to check if a string is a valid phone number, url, email, number, contains only letters. Also provides expressions to manipulate strings (count number of lines, remove new lines, remove non alphanumerical characters).","origin":{"identifier":"InputValidation","name":"gdevelop-extension-store"},"tags":["sanitization","string","string manipulation","input validation"],"authorIds":["ZgrsWuRTAkXgeuPV9bo0zuEcA2w1","AlZ3D1xkH0QDao7T37VZZUeYNpn1"],"dependencies":[],"globalVariables":[],"sceneVariables":[],"eventsFunctions":[{"description":"Check if the string is a valid phone number.","fullName":"Check if a string is a valid phone number","functionType":"Condition","name":"IsValidPhoneNumber","sentence":"_PARAM1_ is a valid phone number","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const phone = eventsFunctionContext.getArgument(\"phone\");","const n = /[0-9 -()+]+$/;","","eventsFunctionContext.returnValue = n.test(phone);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Phone number","name":"phone","type":"string"}],"objectGroups":[]},{"description":"Check if the string is a valid URL.","fullName":"Check if a string is a valid URL","functionType":"Condition","name":"IsValidUrl","sentence":"_PARAM1_ is a valid URL","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const url = eventsFunctionContext.getArgument(\"url\");","const n = /^(?:(?:https?|ftp):\\/\\/)?(?:(?!(?:10|127)(?:\\.\\d{1,3}){3})(?!(?:169\\.254|192\\.168)(?:\\.\\d{1,3}){2})(?!172\\.(?:1[6-9]|2\\d|3[0-1])(?:\\.\\d{1,3}){2})(?:[1-9]\\d?|1\\d\\d|2[01]\\d|22[0-3])(?:\\.(?:1?\\d{1,2}|2[0-4]\\d|25[0-5])){2}(?:\\.(?:[1-9]\\d?|1\\d\\d|2[0-4]\\d|25[0-4]))|(?:(?:[a-z\\u00a1-\\uffff0-9]-*)*[a-z\\u00a1-\\uffff0-9]+)(?:\\.(?:[a-z\\u00a1-\\uffff0-9]-*)*[a-z\\u00a1-\\uffff0-9]+)*(?:\\.(?:[a-z\\u00a1-\\uffff]{2,})))(?::\\d{2,5})?(?:\\/\\S*)?$/;","","eventsFunctionContext.returnValue = n.test(url);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"URL","name":"url","type":"string"}],"objectGroups":[]},{"description":"Check if the string is a valid email.","fullName":"Check if a string is a valid email","functionType":"Condition","name":"IsValidEmail","sentence":"_PARAM1_ is a valid email","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const email = eventsFunctionContext.getArgument(\"email\");","const n = /(([^<>()[\\]\\\\.,;:\\s@\\\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\\\"]+)*)|(\\\".+\\\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))/;","","eventsFunctionContext.returnValue = n.test(email);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Email","name":"email","type":"string"}],"objectGroups":[]},{"description":"Check if the string represents a number (potentially with a minus sign and potentially with a decimal point).","fullName":"Check if a string represents a number","functionType":"Condition","name":"IsValidNumber","sentence":"_PARAM1_ represents a number","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const num = eventsFunctionContext.getArgument(\"num\");","const n = /^-?\\d+\\.?\\d*$/;","","eventsFunctionContext.returnValue = n.test(num);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Number","name":"num","type":"string"}],"objectGroups":[]},{"description":"Check if the string has only latin alphabet letters.","fullName":"Check if a string has only latin alphabet letters","functionType":"Condition","name":"IsOnlyLetters","sentence":"_PARAM1_ has only latin alphabet letters ","events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["const lrt = eventsFunctionContext.getArgument(\"lrt\");","const n = /^[a-zA-Z\\s]*$/;","","eventsFunctionContext.returnValue = n.test(lrt);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"parameters":[{"description":"Letters","name":"lrt","type":"string"}],"objectGroups":[]},{"description":"Returns the string without the first line.","fullName":"Remove the first line","functionType":"StringExpression","name":"RemoveFirstLine","sentence":"","