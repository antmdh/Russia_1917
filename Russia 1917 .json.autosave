ou tous si besoin)","const objets = runtimeScene.getObjects(\"campdedepart_Blancs_IA_unique\");","if (objets.length === 0) {","    console.warn(\"Objet campdedepart_Blancs_IA_unique introuvable dans la scène.\");","    return;","}","const obj = objets[0]; // On prend le premier","","// 2. Accéder au tableau dans les variables de l'objet","const tableau = obj.getVariables().get(\"FCT1_index_tableau_IA\");","","","","// 3. Vérifier qu'il contient bien des éléments","const taille = tableau.getChildrenCount();","if (taille === 0) {","    console.log(\"Le tableau Z_index_tableau_IA est vide.\");","    return;","}","","// 4. Initialiser le MIN avec le premier élément du tableau","let min = tableau.getChild(0).getAsNumber();","","// 5. Parcourir tout le tableau pour trouver la plus petite valeur","for (let i = 1; i < taille; i++) {","    const valeur = tableau.getChild(i).getAsNumber();","    if (valeur < min) {","        min = valeur;","    }","}","","// 6. Une fois que min est trouvé, si tu veux soustraire 1 pour avoir l’index façon \"ligne 0\"","//min = min - 1;  // ou min-- si tu préfères","","// 7. Copier la valeur corrigée dans la variable de l'objet","obj.getVariables().get(\"FCT1_ligne_du_tableau_a_realiser\").setNumber(min);","","// 8. (Optionnel) afficher pour vérifier","console.log(\"Valeur finale envoyée dans Z_ligne_du_tableau_a_realiser :\", min);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT1_Process_IA","=","\"F\""]}]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Etape 4 on sauve les données du dernier \nType de comportement (ACTIF, ACTIF_LIMITE , INACTIF , JOUEUR )de chaque pays sur base de l'information de la ligne choisie et indique que la ligne est réalisé\nles villes cibles (meme si cette colonne n'est plus utile pour l'instant (16.11.25)\nles 4 variables qui determine la zone national ou peuvent bouger les unites a savoir\n-TABLE_COMPORTEMENT_IA.Centrenationaliste_X_NBR\nTABLE_COMPORTEMENT_IA.Centrenationaliste_Y_NBR\nTABLE_COMPORTEMENT_IA.Centrenationaliste_TAILLE_LONGEUR\nTABLE_COMPORTEMENT_IA.Centrenationaliste_TAILLE_HAUTEUR\nqui vont determiner a faire le cercle de detection fixe"},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT1_Process_IA","=","\"F\""]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["TABLE_COMPORTEMENT_IA.Ligne_ecritedanslejeu[campdedepart_Blancs_IA_unique.FCT1_ligne_du_tableau_a_realiser]","True",""]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT1_ligne_du_tableau_a_realiser","!=","0"]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT1_Souscategorieblanc_selectionne","=","\"ALLEMANDS\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT1_derniere_valeur_connue_type.ALLEMANDS","=","TABLE_COMPORTEMENT_IA.STATUT_TXT[campdedepart_Blancs_IA_unique.FCT1_ligne_du_tableau_a_realiser]"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT1_derniere_valeur_connue_villecible.ALLEMANDS","=","TABLE_COMPORTEMENT_IA.VILLE_A_CIBLER_TXT[campdedepart_Blancs_IA_unique.FCT1_ligne_du_tableau_a_realiser]"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["campdedepart_Blancs_IA_unique","FCT1_derniere_valeur_connue_centrenationaliste_X.ALLEMANDS","=","TABLE_COMPORTEMENT_IA.Centrenationaliste_X_NBR[campdedepart_Blancs_IA_unique.FCT1_ligne_du_tableau_a_realiser]"]}]}