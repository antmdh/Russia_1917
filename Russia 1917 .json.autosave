ritable pouvoir populaire; Un pouvoir des conseils; un pouvoir soviétique ! ; Alors, lance-t-on la révolution ? ; Qui est pour ? ;\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","Ordre_scenario","=","\"droite;droite;droite;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite\""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["titregauche_DOCUMENT_SCENARIO_TXT_26c","Text","=","\"COMPTE RENDU DISCUSSION\""]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["Textetegauche_DOCUMENT_SCENARIO_TXT","Text","=","Background_centrale_scenario.Discussion_scenario"]}],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"calcul du nombre de phrase dans la disucussion et rajout de chaque phrase dans une table"},{"folded":true,"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Background_centrale_scenario","fonction_scenaio_etape","=","0"]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","Phraserestante","=","Background_centrale_scenario.Discussion_scenario"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","ordrerestante","=","Background_centrale_scenario.Ordre_scenario"]}],"events":[{"type":"BuiltinCommonInstructions::Repeat","repeatExpression":"100","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","Phraserestante","!=","\"\""]}],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","posSepBis","=","StrFind(Background_centrale_scenario.Phraserestante, \";\")"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberObjectVariable"},"parameters":["Background_ce