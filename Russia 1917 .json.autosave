rue",""]},{"type":{"value":"SetNumberVariable"},"parameters":["etat_vitesse","=","2"]},{"type":{"value":"SetBooleanVariable"},"parameters":["TABLE_MOIS_QUESTION.lancement_premere_question_dumois","True",""]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"PanelSpriteButton::PanelSpriteButton::IsClicked"},"parameters":["Button_refuse",""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["TABLE_MOIS_QUESTION_nbrdepointvirgule",">","1"]}],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["TABLE_MOIS_QUESTION.questionsdumois","=","TABLE_MOIS_QUESTION.lesautresquestionsdumois"]},{"type":{"value":"SetBooleanVariable"},"parameters":["TABLE_MOIS_QUESTION.lancement_premere_question_dumois","True",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["TABLE_MOIS_QUESTION_nbrdepointvirgule","<=","1"]}],"actions":[{"type":{"value":"SetBooleanVariable"},"parameters":["Modestrategique","True",""]},{"type":{"value":"SetNumberVariable"},"parameters":["etat_vitesse","=","2"]},{"type":{"value":"SetBooleanVariable"},"parameters":["TABLE_MOIS_QUESTION.lancement_premere_question_dumois","True",""]}]}]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"BooleanVariable"},"parameters":["Modestrategique","False",""]}],"actions":[],"events":[{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"DATA BASE_CONTENU"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.longeurpointderupture","=","StrLength(point_rupture)"]}]},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Lénine 0\nTRosky 1\nBoukharrine 2"},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Remarque : le texte de database.discussion doit terminer par un \"0\" - être séparé par des \";\" et finir avec \" \""},{"type":"BuiltinCommonInstructions::Comment","color":{"b":109,"g":230,"r":255,"textB":0,"textG":0,"textR":0},"comment":"Valeur à définir\n- Le dialogue séparé en petite phrase: dialogue_petites_phrases\n- L'ordre des dialogues : gauche droite etc.\n- Le dialogue avec le nom et longue phrase et retour à la line\nPage 1\nPage 2\nPage 3\nPage 4\nPage 5\nPage 6\n\n- Le nom des deux personnages : database.personnagegauche et database.personnagedroite\n- La mise en page de la page 1 / 2/3/4 /5 /6\n     - TITRE + TEXTE 400\n     - TEXTE 4000 \n     - TEXTE IMAGE + TEXTE 200\n     - Nom animation\n\n- Animation image cover\n\n- Le nom du titre de la page 1"},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"1.Faire_la_revolution\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"ZINOVIEV\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"Camarades ; Le moment est venu; Les bolcheviks peuvent et doivent ; prendre le pouvoir d’État ; Les masses sont prêtes; Kerenski, le premier ministre ; qui veut continuer la guerre, est faible; Camarade Vladimir Ilitch ; Ou camarade Lénine comme ; beaucoup te connaissent; Le parti n’est pas assez fort ; Les mencheviks et les SR de droite; Ces partis socialistes modérés ; Ne sont pas avec nous; Attendons que le Congrès des Soviets ; Cette grande assemblée qui réunit les soldats; les ouvriers et les paysans se réunisse; Attendre ? C’est laisser Kerenski s’organiser; Les ouvriers, les soldats, les marins; Ils veulent le pain, la terre, la paix; Nous pouvons leur donner ça; Et si nous échouons ? ; Comme en 1871 lors de la Commune de Paris ?; Si les provinces ne nous suivent pas ; Les Soviets sont avec nous ; Les usines sont avec nous; L’insurrection, c’est un art ; Il faut frapper maintenant ; Vous parlez de victoire ; Moi, je vois le risque ; Une révolution sans risque, ça n’existe pas ; Le pouvoir est à portée de main ; Votons; L’Histoire ne pardonnera pas l’hésitation; Qui vote pour mener l'insurection ; avant l'ouverture du congrès des Soviets ?; Et lui le remettre le pouvoir ?;0;\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"gauche;gauche;gauche;gauche;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;gauche;droite;droite;droite;gauche;gauche;gauche;gauche;droite;droite;gauche;gauche;gauche;gauche;gauche;gauche;gauche;\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"Lénine : \nCamarades, le moment est venu. Les bolcheviks peuvent et doivent prendre le pouvoir d'État. Les masses sont prêtes. Kerenski, le premier ministre qui veut continuer la guerre, est faible.\n\nZinoviev : \nCamarade Vladimir Ilitch, ou camarade Lénine comme beaucoup te connaissent, le parti n’est pas assez fort. Les mencheviks et les SR de droite, ces partis socialistes modérés, ne sont pas avec nous. Attendons que le Congrès des Soviets, cette grande assemblée qui réunit les soldats, les ouvriers et les paysans, se réunisse. \n\nLénine : \nAttendre ? C’est laisser Kerenski s’organiser. Les ouvriers, les soldats, les marins veulent le pain, la terre, la paix. Nous pouvons leur donner cela. \n\nZinoviev : \nEt si nous échouons, comme en 1871 lors de la Commune de Paris ? Si les provinces ne nous suivent pas ?\n\nLénine : \nLes Soviets sont avec nous, les usines sont avec nous. L’insurrection, c’est un art. Il faut frapper maintenant. \n\nZinoviev : \nVous parlez de victoire, moi je vois le risque. \n\nLénine : \nUne révolution sans risque, cela n’existe pas. Le pouvoir est à portée de main. Votons. L’Histoire ne pardonnera pas l’hésitation. Qui vote pour mener l’insurrection avant l’ouverture du congrès des Soviets et lui remettre le pouvoir ?\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_RESUME","=","\"Pour l’insurrection en octobre 1917 :\n\nOpportunité révolutionnaire (les masses sont prêtes, Kerenski est faible) et réponse aux demandes populaires (pain, terre, paix) ; une prise de pouvoir immédiate permettrait d’éviter que la contre-révolution (junkers, Cosaques, Kerenski) ne s’organise et de concrétiser l’élan révolutionnaire après l’échec de Kornilov. L’insurrection est un art : frapper maintenant, c’est saisir un moment historique où les Soviets, les usines et les soldats sont avec les bolcheviks. Attendre, c’est risquer de perdre l’initiative et de laisser l’ennemi se renforcer.\n\nContre l’insurrection en octobre 1917 :\n\nRisque d’isolement (les provinces et les socialistes modérés, comme les mencheviks et les SR de droite, ne suivent pas) et manque de préparation militaire ; une défaite pourrait être catastrophique, comme la Commune de Paris en 1871. Attendre le Congrès des Soviets offrirait une légitimité démocratique et permettrait de consolider les alliances. L’unité prolétarienne doit primer : une insurrection prématurée pourrait diviser les forces révolutionnaires et affaiblir le parti face à une répression sanglante.\n\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_EFFET","=","\"Si vous lancez l’insurrection, vous prendrez le contrôle des gardes rouges sur la carte stratégique et engagerez le combat pour édifier l’Union Soviétique. En revanche, si vous refusez, vous perdrez l’occasion historique de saisir le pouvoir, condamnant ainsi le projet de construire une société socialiste sur les ruines de l’Empire tsariste. Le choix est décisif : agir maintenant ou risquer l’échec de la révolution.\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_PV","=","\"FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_RESUME","=","\"Page1_FULL_TEXTE_GAUCHE_1_IMAGE_DROITE_PAGESUIVANTE_FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_EFFET","=","\"FULL_TEXTE\""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_PV","=","2"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_EFFET","=","1"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_RESUME","=","2"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.NOM_IMAGE_RAPPORT","=","\"1.Faire_la_revolution\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.Question_secondaire","=","\"LANCER L'INSURRECTION ?\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"2.Decret_sur_la_terre\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"SEREDA\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"Camarade Sereda, écoutez-moi bien;Les paysans réclament la terre;depuis des siècles; Kerenski a tergiversé pendant huit mois;Nous, nous devons agir maintenant; Nous devons redistribuer; la terre aux paysans; Ce décret, c’est leur volonté à eux; pas la nôtre; Mais c’est un levier; Nous confisquons les terres; des grands propriétaires; des monastères, du Tsar; sans indemnité; Les comités agraires et; les Soviets paysans géreront; la redistribution; C’est une victoire immédiate; contre le capitalisme agraire; Vladimir Ilitch; c’est une trahison de nos principes !; Notre programme exige la gestion collective; pas ce partage égalitaire de la terre; en parcelles individuelles; Ce ‘Mandat paysan’, c’est du populisme; du parti socialiste révolutionnaire ! ; Nous devons éduquer les masses; pas céder à leurs illusions petit-bourgeoises; La terre aux paysans individuellement ?; C’est recréer des micro-exploitations; capitalistes sous un autre nom; Trahison ? Non. Stratégie; Regardez; Abolition de la propriété privée; Interdiction du travail salarié; Partage selon le besoin; Oui, ce n’est pas; la collectivisation tout de suite; Mais c’est un coup mortel; porté aux banques et ; Aux koulaks, ces paysans riches; 150 millions d’hectares confisqués; un milliard de roubles de dettes effacées; Les paysans verront bien que; leurs lopins ne suffisent pas; La misère les poussera; vers une gestion collective; L’expérience leur apprendra ce; que nos tracts ne peuvent pas leur dire; Et en attendant ?; Nous légalisons; la parcelle individuelle !; Les riches paysans garderont; leurs avantages; les pauvres resteront pauvres; et nous aurons perdu notre crédibilité; Le parti Socialiste Révolutionnaire; va crier victoire; ‘Regardez les bolcheviks’; ‘Ils appliquent notre programme !’; Ils crieront victoire…; jusqu’à ce que; les paysans réalisent que; nous seuls leur avons donné la terre; Kerenski, l’ancien premier ministre; il a promis des réformes; Où sont-elles ? Nous, nous agissons!; Ce décret arrache la paysannerie; à l’influence; des Socialistes Révolutionnaires; Sans elle, la révolution est isolée; Vous préférez une pureté doctrinale; Ou un pouvoir soviétique qui tient ?; Et si les paysans s’accrochent; à leurs parcelles ?; Si la collectivisation devient impossible ?; Alors nous aurons le temps de les convaincre; Mais d’abord, il faut survivre; Sans le blé des campagnes; Petrograd meurt de faim; Sans leur soutien, Les contre révolutionnaires nous écraseront; Croyez-vous que les paysans; Une fois libres de leurs dettes; Vont pleurer les koulaks; ces paysans riches ?; Non ! ; Ils nous suivront quand; ils verront que seuls; nous défendons leurs intérêts; La théorie, c’est bien; Avoir les paysans avec nous; c’est indispensable !;Vous pariez sur l’échec; de ce décret proposé par ; le parti des Socialistes Révolutionnaires Je parie sur la logique de l’Histoire; camarade; La terre aux paysans aujourd’hui… ; et demain, ils comprendront que; la terre à la collectivité; c’est la seule solution; Votons camarade; Alors ? ; Pour ou contre le décret; qui redistribue la terre aux paysans ?; 0; \""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"Lénine :\nCamarade Sereda, écoutez-moi bien. Les paysans réclament la terre depuis des siècles. Kerenski, l'ancien chef de gouvernement que nous venons de renverser, a tergiversé pendant huit mois. Nous, nous devons agir maintenant. Nous devons redistribuer la terre aux paysans. Ce décret, c’est leur volonté à eux, pas la nôtre. Mais c’est un levier. Nous confisquons les terres des grands propriétaires, des monastères, de la couronne – sans indemnité. Les comités agraires et les Soviets paysans géreront la redistribution. C’est une victoire immédiate contre le capitalisme agraire.\n\nSereda :\nVladimir Ilitch, c’est une trahison de nos principes ! Notre programme exige la gestion collective, pas ce partage égalitaire en parcelles individuelles. Ce 'Mandat paysan', c’est du populisme du parti socialiste révolutionnaire (SR) ! Nous devons éduquer les masses, pas céder à leurs illusions petit-bourgeoises. La terre aux paysans individuellement ? C’est recréer des micro-exploitations capitalistes sous un autre nom.\n\nLénine:\nTrahison ? Non. Stratégie. Regardez : abolition de la propriété privée, interdiction du travail salarié, partage selon le besoin. Oui, ce n’est pas la collectivisation tout de suite… mais c’est un coup mortel porté aux koulaks et aux banques. 150 millions d’hectares confisqués, un milliard de roubles de dettes effacées. Les paysans verront bien que leurs lopins ne suffisent pas. La misère les poussera vers une gestion collective. L’expérience leur apprendra ce que nos tracts ne peuvent pas leur dire.\n\nSereda :\nEt en attendant ? Nous légalisons la parcelle individuelle ! Les riches paysans garderont leurs avantages, les pauvres resteront pauvres, et nous aurons perdu notre crédibilité. Le parti socialiste-révolutionnaire (SR) va crier victoire : 'Regardez, les bolcheviks appliquent notre programme !'\n\nLénine :\nIls crieront victoire… jusqu’à ce que les paysans réalisent que nous seuls leur avons donné la terre. Kerenski (chef du précédent gouvernement) a promis des réformes. Où sont-elles ? Nous, nous agissons. Ce décret arrache la paysannerie à l’influence des Socialistes Révolutionnaires. Sans elle, la révolution est isolée. Vous préférez une pureté doctrinale… ou un pouvoir soviétique qui tient ?\n\nSereda :\nEt si les paysans s’accrochent à leurs parcelles ? Si la collectivisation devient impossible ?\n\nLénine :\nAlors nous aurons le temps de les convaincre. Mais d’abord, il faut survivre. Sans le blé des campagnes, Petrograd meurt de faim. Sans leur soutien, les contre révolutionnaires nous écraseront. Croyez-vous que les paysans, une fois libres de leurs dettes, vont pleurer les koulaks, ces paysans riches ? Non. Ils nous suivront quand ils verront que seuls nous défendons leurs intérêts. La théorie, c’est bien. Avoir les paysans avec nous, c’est mieux\n\nSereda :\nVous pariez sur l’échec de ce décret proposé par le parti des Socialistes Révolutionnaires \n\nLénine :\nJe parie sur la logique de l’Histoire, camarade. La terre aux paysans aujourd’hui… et demain, ils comprendront que la terre à la collectivité, c’est la seule solution. Votons camarade. Alors ? Pour ou contre le décret qui redistribue la terre aux paysans ?\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_RESUME","=","\"Option Lénine – Pragmatisme révolutionnaire :\n\nRedistribuer la terre immédiatement aux paysans selon leurs revendications (parcelles individuelles), même si cela s’éloigne temporairement du programme bolchevique de gestion collective de la terre.\n\nAvantages :\n- Gagner le soutien massif des paysans en répondant à leurs attentes.\n- Affaiblir les propriétaires terriens et les banques en abolissant la propriété privée.\n- Isoler les Socialistes Révolutionnaires (SR) en montrant que seuls les bolcheviks agissent concrètement.\n- Assurer la survie du pouvoir soviétique en sécurisant l’approvisionnement en blé et en neutralisant la menace contre-révolutionnaire.\n\nRisque : \n- La parcelle individuelle pourrait freiner la collectivisation future, mais Lénine parie sur le fait que les paysans, confrontés aux limites de leurs lopins, se tourneront vers le collectivisme par nécessité.\n\n\nOption Sereda – Rigidité idéologique :\n\nRejeter le décret et insister sur la collectivisation immédiate des terres, conformément au programme bolchevique qui avait été défendu par Lénine en Avril 1917.\n\nAvantages :\nMaintenir la cohérence idéologique du parti.\nÉviter de légitimer des structures agraires 'petit-bourgeoises'.\n\nRisque :\nPerdre le soutien des masses paysannes, crucial pour la survie de la révolution.\nLaisser les SR capitaliser sur la frustration rurale et affaiblir le pouvoir soviétique.\nAggraver la crise alimentaire et isoler les villes, menant potentiellement à l’effondrement du régime face aux forces contre-révolutionnaires.\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_EFFET","=","\"L'adoption du décret sur la terre entraînera une adhésion massive des populations à la révolution. Concrètement, cela favorisera l'émergence spontanée de gardes rouges dans plusieurs villes de Russie.\n\nÀ l'inverse, le refus du décret provoquera un éloignement des masses vis-à-vis de la révolution. Toute tentative ultérieure de confiscation des ressources agricoles se heurtera à des résistances bien plus fortes que si le décret avait été adopté immédiatement. Toutefois, ce refus pourrait éviter une scission au sein du parti socialiste révolutionnaire (SR) et réduire les risques d'attentat contre Lénine, ainsi que la formation d'un gouvernement anti-bolchevique dirigé par les SR.\"\n"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_PV","=","\"FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_RESUME","=","\"Page1_FULL_TEXTE_GAUCHE_1_IMAGE_DROITE_PAGESUIVANTE_FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_EFFET","=","\"FULL_TEXTE\""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_PV","=","4"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_EFFET","=","4"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_RESUME","=","1"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.NOM_IMAGE_RAPPORT","=","\"2.Decret_sur_la_terre\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.Question_secondaire","=","\"Valider le décret sur la terre\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"3.Decret_sur_la_paix\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"BOUKHARINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"Camarades; l'un de nos premiers actes; doit être un Décret sur la Paix; C'est la clé Nous le présenterons; au Congrès des Soviets; Il doit proposer immédiatement; à tous les peuples une paix juste; sans annexions; sans indemnités; Nous publierons tous; les traités secrets du tsar ; et de Kerenski ; le précédent chef de gouvernement; que nous avons renversé ; nous dévoilerons le vrai visage ; de cette guerre impérialiste Je suis d'accord sur le fond ; Vladimir Ilitch ; Un manifeste contre la guerre ; est essentiel; Mais le présenter comme une offre ; de négociations aux gouvernements ? ; C'est dangereux ; Cela pourrait être interprété ; comme notre volonté de traiter ; avec ces bandits impérialistes ; Notre appel doit être exclusivement; un cri de ralliement aux prolétaires; d'Europe pour qu'ils renversent; leurs bourgeoisies; Pas un formulaire de paix. C'est justement ; son double tranchant ; qui fait sa force !; Oui, c'est un manifeste incendiaire; pour la révolution mondiale; Mais c'est aussi une offre politique; concrète qui répond à la soif de paix; du soldat russe. Elle nous légitimera; aux yeux des millions qui crèvent; dans les tranchées; Si nous refusons de parler de paix; nous tombons avant même de commencer; Et si l'Allemagne accepte ? ; Si elle dit qu'elle accepte ; la paix avec l'annexion ; de l'Ukraine ? ; Ce décret nous engage ; dans un processus diplomatique; pervers; Nous serons piégés entre nos principes; et la réalité militaire ; Mieux vaut proclamer la ; « guerre révolutionnaire » dès le début; appeler à la levée en masse ; contre l'envahisseur impérialiste !; Tu vis dans les nuages! ; Quelle armée ? L'armée se désagrège ! ; Elle votera pour la paix avec ses pieds ; en désertant; Notre force actuelle, c'est la promesse ; de mettre fin au carnage immédiatement ; Ce décret est notre ancrage dans la réalité ; Il nous donnera le souffle nécessaire ; pour organiser le pouvoir ; Sans ce répit, la contre-révolution ; nous écrasera; Tu veux utiliser le désir de paix ; des masses pour consolider un État; même au prix d'une future compromission; avec l'impérialisme; C'est jouer avec le feu; Nous devons être intransigeants ; la seule issue ; c'est l'extension mondiale ; de la révolution ; Notre premier mot doit être 'Guerre !'; guerre contre la bourgeoisie mondiale; Notre premier mot doit être « Paix ! » ; pour gagner du temps et des partisans; Nous transformerons ensuite cette paix ; en préparation à la guerre civile ; inévitable ici, en Russie ; Le décret est une manœuvre tactique ; de première importance; Il n'interdit pas la guerre ; révolutionnaire plus tard; il la rend possible en nous ; sauvant aujourd'hui; Il faut le voter; Ce décret, dans sa forme ; est un premier pas vers la capitulation; L'histoire nous jugera; L'histoire jugera ceux qui auront sauvé; la révolution russe pour qu'elle puisse; un jour, enflammer le monde; Que votons nous ?\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; gauche; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; droite; gauche; gauche; gauche; droite; droite; droite; droite;\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"Lénine :\nCamarades, l'un de nos premiers actes doit être un Décret sur la Paix. C'est la clé. Nous le présenterons au Congrès des Soviets. Il doit proposer immédiatement à tous les peuples une paix juste : sans annexions, sans indemnités. Nous publierons tous les traités secrets du tsar et de Kerenski, le précédent chef de gouvernement que nous avons renversé, nous dévoilerons le vrai visage de cette guerre impérialiste.\n\nBoukharine :\nJe suis d'accord sur le fond, Vladimir Ilitch. Un manifeste contre la guerre est essentiel. Mais le présenter comme un décret, comme une offre de négociations aux gouvernements ? C'est dangereux. Cela pourrait être interprété comme notre volonté de traiter avec ces bandits impérialistes. Notre appel doit être exclusivement un cri de ralliement aux prolétaires d'Europe pour qu'ils renversent leurs bourgeoisies ! Pas un formulaire de paix.\n\nLénine :\nC'est justement son double tranchant qui fait sa force ! Oui, c'est un manifeste incendiaire pour la révolution mondiale. Mais c'est aussi une offre politique concrète qui répond à la soif de paix du soldat russe. Elle nous légitimera aux yeux des millions qui crèvent dans les tranchées. Si nous refusons de parler de paix, nous tombons avant même de commencer.\n\nBoukharine :\nEt si l'Allemagne accepte ? Si elle dit : « Très bien, signons une paix... sur nos termes, avec l'annexion de l'Ukraine » ? Ce décret nous engage dans un processus diplomatique pervers. Nous serons piégés entre nos principes et la réalité militaire. Mieux vaut proclamer la « guerre révolutionnaire » dès le début, appeler à la levée en masse contre l'envahisseur impérialiste !\n\nLénine :\nTu vis dans les nuages! Quelle armée ? L'armée se désagrège ! Elle votera pour la paix avec ses pieds, en désertant. Notre force actuelle, c'est la promesse de mettre fin au carnage immédiatement. Ce décret est notre ancrage dans la réalité. Il nous donnera le souffle nécessaire pour organiser le pouvoir. Sans ce répit, la contre-révolution nous écrasera.\n\nBoukharine :\nTu veux utiliser le désir de paix des masses pour consolider un État, même au prix d'une future compromission avec l'impérialisme. C'est jouer avec le feu. Nous devons être intransigeants : la seule issue, c'est l'extension mondiale de la révolution. Notre premier mot doit être 'Guerre !'  – guerre contre la bourgeoisie mondiale.\n\nLénine :\nNotre premier mot doit être « Paix ! » pour gagner du temps et des partisans. Nous transformerons ensuite cette paix en préparation à la guerre civile inévitable ici, en Russie. Le décret est une manœuvre tactique de première importance. Il n'interdit pas la guerre révolutionnaire plus tard, il la rend possible en nous sauvant aujourd'hui. Il faut le voter.\n\nBoukharine :\nAlors nous nous opposerons. Ce décret, dans sa forme, est un premier pas vers la capitulation. L'histoire nous jugera.\n\nLénine :\nL'histoire jugera ceux qui auront sauvé la révolution russe pour qu'elle puisse, un jour, enflammer le monde. Que votons nous ?\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_RESUME","=","\"En novembre 1917, juste après la prise du pouvoir par les bolcheviks, le Décret sur la Paix est au cœur des débats. Ce texte propose une paix immédiate, sans annexions ni indemnités, tout en dénonçant les traités secrets impérialistes. L’enjeu : mettre fin à la Première Guerre mondiale, qui saigne la Russie depuis 1914, tout en lançant un appel révolutionnaire aux prolétaires européens. Mais comment concilier idéal révolutionnaire et réalisme politique ? Deux visions s’affrontent : Lénine, pragmatique, et Boukharine, intransigeant.\n\nLénine :\n\nPriorité absolue : Arrêter la guerre pour sauver la révolution russe, menacée par l’effondrement de l’armée et la contre-révolution.\nStratégie :\n\nUtiliser le décret comme outil de propagande (révéler les traités secrets pour discréditer les gouvernements belligérants).\nRépondre à l’aspiration massive des soldats et paysans à la paix, afin de consolider le pouvoir soviétique.\nGagner du temps pour organiser l’Armée Rouge et préparer la guerre civile inévitable.\nUne paix même temporaire n’est pas une trahison, mais une manœuvre tactique pour survivre.\n\nBoukharine (et les 'communistes de gauche') :\n\nRefus de tout compromis avec les impérialistes, même sous forme de négociations.\nRisque : Le décret pourrait piéger les bolcheviks dans des concessions (ex. : annexion de l’Ukraine par l’Allemagne).\nAlternative : Proclamer une « guerre révolutionnaire » pour inciter les ouvriers européens à se soulever, quitte à affronter une défaite héroïque.\nCrainte : Une paix négociée = abandon des principes internationalistes et affaiblissement de l’élan révolutionnaire.\"\n\n\n"]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_EFFET","=","\"Si vous acceptez le décret sur la terre et appelez à la paix, vous provoquerez l'intervention des puissances occidentales (France, Angleterre, États-Unis, Japon), qui viendront combattre à leur tour sur le sol russe pour empêcher la propagation de la révolution.\n\nEn revanche, si vous refusez ces mesures, vous perdrez le soutien des soldats, épuisés par une guerre qu'ils considèrent comme impérialiste. Sans leur adhésion, il vous sera impossible de constituer une Armée rouge et de défendre la révolution, laissant le régime bolchevique vulnérable face à ses ennemis intérieurs et extérieurs.\n\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_PV","=","\"FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_RESUME","=","\"Page1_FULL_TEXTE_GAUCHE_1_IMAGE_DROITE_PAGESUIVANTE_FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_EFFET","=","\"FULL_TEXTE\""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_PV","=","4"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_EFFET","=","4"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_RESUME","=","1"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.NOM_IMAGE_RAPPORT","=","\"3.Decret_sur_la_paix\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.Question_secondaire","=","\"Valider le décret sur la paix\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"4.Droit_autodetermination_peuples\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"ZINOVIEV\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;4.Droit_autodetermination_peuples;\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"4_droit_A_autodeterminationdespeuples\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_RESUME","=","\"4_droit_A_autodeterminationdespeuples\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_EFFET","=","\"4_droit_A_autodeterminationdespeuples\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_PV","=","\"FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_RESUME","=","\"Page1_FULL_TEXTE_GAUCHE_1_IMAGE_DROITE_PAGESUIVANTE_FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_EFFET","=","\"FULL_TEXTE\""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_PV","=","2"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_EFFET","=","2"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_RESUME","=","1"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.NOM_IMAGE_RAPPORT","=","\"4.Droit_autodetermination_peuples\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.Question_secondaire","=","\"4.Droit_autodetermination_peuples\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"5.Decret_controle_ouvrier\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"ZINOVIEV\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;5.Decret_controle_ouvrier;\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"5.Decret_controle_ouvrier\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_RESUME","=","\"5.Decret_controle_ouvrier\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_EFFET","=","\"5.Decret_controle_ouvrier\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_PV","=","\"FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_RESUME","=","\"Page1_FULL_TEXTE_GAUCHE_1_IMAGE_DROITE_PAGESUIVANTE_FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_EFFET","=","\"FULL_TEXTE\""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_PV","=","2"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_EFFET","=","2"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_RESUME","=","1"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.NOM_IMAGE_RAPPORT","=","\"5.Decret_controle_ouvrier\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.Question_secondaire","=","\"5.Decret_controle_ouvrier\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"6.Creation_tcheka\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"ZINOVIEV\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;6.Creation_tcheka;\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"6.Creation_tcheka\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_RESUME","=","\"6.Creation_tcheka\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_EFFET","=","\"6.Creation_tcheka\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_PV","=","\"FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_RESUME","=","\"Page1_FULL_TEXTE_GAUCHE_1_IMAGE_DROITE_PAGESUIVANTE_FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_EFFET","=","\"FULL_TEXTE\""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_PV","=","2"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_EFFET","=","2"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_RESUME","=","1"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.NOM_IMAGE_RAPPORT","=","\"6.Creation_tcheka\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.Question_secondaire","=","\"6.Creation_tcheka\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"7.Independance_finlande\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"BOUKHARINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"0;Camarades;La Finlande réclame l’indépendance;Ce n’est pas nouveau;Ils souffrent depuis des décennies;Sous l’oppression tsariste;Justement;C’est une raison de plus;Pour rompre avec l’empire;En reconnaissant l’indépendance;Nous brisons l’héritage du tsar;Et nous séparons les classes;La bourgeoisie blanche veut une Russie unie;Les travailleurs veulent la liberté;Une reconnaissance les divise;Tu idéalises;Une nation reste une nation;Elle unit bourgeois et prolétaires;Reconnaître l’indépendance;C’est reconnaître le droit ;de la bourgeoisie finlandaise;À exploiter sous son propre drapeau;La classe doit primer;Pas la nation;Mais sans indépendance;Les ouvriers finlandais ;nous verront comme des oppresseurs;Comme avant;Une fois la question nationale réglée;La lutte de classe devient claire;Les travailleurs pourront se retourner;Contre leurs propres capitalistes;Tu parles de demain;Moi je parle d’aujourd’hui;Il y a des troupes rouges en Finlande;Des combattants;Des armes;Ils peuvent nous renforcer;Si nous restons unis;Si la Finlande se sépare;Nous perdons cette force;Et l’accès à la mer;Des ports libres des glaces;Stratégiques;Sans eux;La révolution est plus isolée;Et si nous refusons;La Finlande devient une base arrière;Pour les puissances étrangères;Pour l’Allemagne;Pour ceux qui veulent écraser la révolution;Une reconnaissance ferme cette porte;Tu en es sûr ?;Une Finlande indépendante;Peut aussi appeler les Allemands;Contre ses propres rouges;Nous leur offrons un État;Et ils l’utiliseront contre nous;L’unité prolétarienne;Voilà la priorité;Pas les frontières;L’indépendance est un réflexe petit-bourgeois;Les masses veulent le pouvoir;Pas un drapeau;Et pourtant;Sans liberté nationale;Il n’y a pas de confiance;Sans confiance;Pas de révolution internationale;Le choix est brutal;Principe ou stratégie;Nation ou classe;Risque immédiat;Ou oppression prolongée;Alors camarades;Qui est pour reconnaitre ;l’indépendance de la Finlande?; \""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite;droite\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"Lénine : \nCamarades.\nLa Finlande réclame l’indépendance. Ce n’est pas nouveau : ils souffrent depuis des décennies sous l’oppression tsariste.\nJustement, c’est une raison de plus pour rompre avec l’empire. En reconnaissant leur indépendance, nous brisons l’héritage du tsar. Et nous séparons les classes.\nLa bourgeoisie blanche veut une Russie unie, mais les travailleurs veulent la liberté. Une reconnaissance les divise.\n\nBoukharine : \nTu idéalises. Une nation reste une nation : elle unit bourgeois et prolétaires. Reconnaître l’indépendance, c’est reconnaître le droit de la bourgeoisie finlandaise à exploiter sous son propre drapeau.\nLa classe doit primer, pas la nation. \n\nLénine : \nMais sans indépendance, les ouvriers finlandais nous verront comme des oppresseurs, comme avant.\nUne fois la question nationale réglée, la lutte de classe devient claire. Les travailleurs pourront se retourner contre leurs propres capitalistes.\n\nBoukharine : \nTu parles de demain, moi je parle d’aujourd’hui. Il y a des troupes rouges en Finlande, des combattants, des armes. Ils peuvent nous renforcer si nous restons unis. Si la Finlande se sépare, nous perdons cette force, et l’accès à la mer. Des ports libres des glaces, stratégiques. Sans eux, la révolution est plus isolée.\n\nLénine : \nEt si nous refusons ? La Finlande devient une base arrière pour les puissances étrangères, pour l’Allemagne, pour ceux qui veulent écraser la révolution. Une reconnaissance ferme cette porte.\n\nBoukharine : \nTu en es sûr ? Une Finlande indépendante peut aussi appeler les Allemands contre ses propres rouges. Nous leur offrons un État, et ils l’utiliseront contre nous.\nL’unité prolétarienne, voilà la priorité, pas les frontières. L’indépendance est un réflexe petit-bourgeois. Les masses veulent le pouvoir, pas un drapeau.\n\nLénine : \nEt pourtant, sans liberté nationale, il n’y a pas de confiance. Sans confiance, pas de révolution internationale.\n\nLe choix est brutal. Principe ou stratégie, nation ou classe, risque immédiat ou oppression prolongée.\nAlors, camarades, qui est pour reconnaître l’indépendance de la Finlande ?\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_RESUME","=","\"Pour l’indépendance :\nLibération des travailleurs (rupture avec le tsarisme) et éviter de paraître comme des oppresseurs ; une Finlande indépendante pourrait mieux combattre ses propres capitalistes et limiter les risques d’ingérence étrangère.\n\n\nContre l’indépendance :\nRisque stratégique (perte des ports et des troupes rouges) et division des forces révolutionnaires ; priorité à l’unité prolétarienne plutôt qu’aux frontières nationales, perçues comme un piège petit-bourgeois.\n\n\nDilemme central :\nNation vs. classe : faut-il privilégier la confiance des masses (liberté nationale) ou l’unité révolutionnaire (force militaire et économique) ? Un choix entre risque immédiat et oppression prolongée.\n\n\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_EFFET","=","\"Voici les conséquences pratiques attendues de votre décision.\nSi vous reconnaissez l’indépendance finlandaise :\n\nLes troupes blanches finlandaises cesseront de vous attaquer, et des frontières apparaîtront. Vous n’aurez plus accès à la ville d’Helsinki, ni à Mourmansk si elle est actuellement occupée par les Finlandais.\nVous perdrez le contrôle des troupes bolcheviks finlandaises, qui tenteront de faire la révolution socialiste dans leur propre pays.\nVous réduirez les risques d’interventions étrangères (Allemands, Français, Anglais, Américains).\n\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_PV","=","\"FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_RESUME","=","\"Page1_FULL_TEXTE_GAUCHE_1_IMAGE_DROITE_PAGESUIVANTE_FULL_TEXTE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.miseenpagerapportdediscussion_EFFET","=","\"FULL_TEXTE\""]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_PV","=","3"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_EFFET","=","1"]},{"type":{"value":"SetNumberObjectVariable"},"parameters":["Background_centrale_scenario","database.rapportdiscussion_nbrdedoublepage_RESUME","=","2"]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.NOM_IMAGE_RAPPORT","=","\"7.Independance_finlande\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.Question_secondaire","=","\"Reconnaître independance de la Finalnde\""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"StringObjectVariable"},"parameters":["Background_centrale_scenario","scenario","=","\"8.Mariage_civil_egalite_hf\""]}],"actions":[{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagegauche","=","\"LENINE\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.personnagedroite","=","\"ZINOVIEV\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.dialogue_petites_phrases","=","\"8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;8.Mariage_civil_egalite_hf;\""]},{"type":{"value":"SetStringObjectVariable"},"parameters":["Background_centrale_scenario","database.parcoursgauchedroite","=","\"gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;gauche;\""]},{"type":{"value":"SetStringVariable"},"parameters":["texte_rapport_PV","=","\"8_dec